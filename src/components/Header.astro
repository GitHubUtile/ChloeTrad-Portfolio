---
import { type Lang } from '../i18n/languages';
import { useTranslation, getLocalizedPath } from '../i18n/utils';
import { mainNav } from '../data/navigation';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from '../islands/ThemeToggle.tsx';

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const t = useTranslation(lang);
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-50 transition-colors duration-300"
  style="background: color-mix(in oklab, var(--bg) 88%, transparent); backdrop-filter: blur(8px);"
>
  <div class="container-page flex items-center justify-between py-4 lg:py-5">
    <a
      href={getLocalizedPath(lang, '/')}
      class="font-display text-base lg:text-lg tracking-tight cursor-pointer flex items-baseline gap-2"
    >
      <span class="font-semibold">Chloe</span><span class="text-[var(--muted)] italic">Trad</span>
    </a>

    <nav class="hidden lg:flex items-center gap-8" aria-label="Main navigation">
      {mainNav.map((item) => {
        const target = getLocalizedPath(lang, item.path);
        const normTarget = target.replace(/\/$/, '');
        const normCurrent = currentPath.replace(/\/$/, '');
        const isActive = item.path === '/'
          ? normTarget === normCurrent
          : normCurrent.startsWith(normTarget);
        return (
          <a
            href={target}
            class:list={[
              'group relative text-[0.7rem] font-mono uppercase tracking-[0.15em] transition-colors duration-200 cursor-pointer py-2',
              isActive
                ? 'text-[var(--accent)] after:absolute after:bottom-0 after:left-0 after:w-full after:h-0.5 after:bg-[var(--accent)]'
                : 'text-[var(--ink)] hover:text-[var(--accent)]',
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            <span class="text-[var(--muted)] mr-1.5">{(mainNav.indexOf(item) + 1).toString().padStart(2, '0')}</span>{t(item.key)}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-3 lg:gap-4">
      <LanguageSwitcher lang={lang} />
      <span class="hidden lg:inline-block w-px h-4 bg-[var(--rule)]"></span>
      <ThemeToggle client:load />
      <button
        id="mobile-menu-toggle"
        class="lg:hidden p-2 cursor-pointer -mr-2"
        aria-label="Open menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 7.5h16.5M3.75 12h16.5M3.75 16.5h16.5" />
        </svg>
      </button>
    </div>
  </div>

</header>

<div
  id="mobile-menu"
  class="fixed inset-0 bg-[var(--bg)] z-[60] flex-col items-stretch justify-between opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden hidden"
  aria-hidden="true"
>
  <div class="container-page flex items-center justify-between py-4">
    <span class="font-display text-base tracking-tight">Chloe<span class="italic text-[var(--muted)]"> Trad</span></span>
    <button
      id="mobile-menu-close"
      class="p-2 cursor-pointer -mr-2"
      aria-label="Close menu"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav class="container-page flex-1 flex flex-col justify-center gap-6" aria-label="Mobile navigation">
    {mainNav.map((item, i) => {
      const target = getLocalizedPath(lang, item.path);
      const normTarget = target.replace(/\/$/, '');
      const normCurrent = currentPath.replace(/\/$/, '');
      const isActive = item.path === '/'
        ? normTarget === normCurrent
        : normCurrent.startsWith(normTarget);
      return (
        <a
          href={target}
          class:list={[
            'flex items-baseline gap-4 font-display text-4xl tracking-tight transition-colors duration-200 cursor-pointer',
            isActive ? 'text-[var(--accent)]' : 'hover:text-[var(--accent)]',
          ]}
          data-mobile-link
        >
          <span class="font-mono text-xs text-[var(--muted)]">{(i + 1).toString().padStart(2, '0')}</span>
          <span>{t(item.key)}</span>
        </a>
      );
    })}
  </nav>

  <div class="container-page flex items-center justify-between py-8 safe-bottom border-t border-[var(--rule)]">
    <LanguageSwitcher lang={lang} />
    <ThemeToggle client:load />
  </div>
</div>

<script>
  const header = document.getElementById('site-header');
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('mobile-menu-close');
  const overlay = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('[data-mobile-link]');

  function openMenu() {
    if (!overlay || !toggleBtn) return;
    overlay.classList.remove('hidden', 'opacity-0', 'pointer-events-none');
    overlay.classList.add('flex', 'opacity-100', 'pointer-events-auto');
    overlay.setAttribute('aria-hidden', 'false');
    toggleBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeMenu() {
    if (!overlay || !toggleBtn) return;
    overlay.classList.add('opacity-0', 'pointer-events-none');
    overlay.classList.remove('opacity-100', 'pointer-events-auto');
    overlay.setAttribute('aria-hidden', 'true');
    toggleBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    setTimeout(() => {
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
    }, 300);
  }

  toggleBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  mobileLinks.forEach(a => a.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  // Subtle header shadow on scroll
  function onScroll() {
    if (!header) return;
    if (window.scrollY > 12) {
      header.style.borderBottom = '1px solid var(--rule)';
    } else {
      header.style.borderBottom = '1px solid transparent';
    }
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
