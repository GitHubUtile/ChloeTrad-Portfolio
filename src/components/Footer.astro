---
import { type Lang } from '../i18n/languages';
import { useTranslation, getLocalizedPath, getLocalizedContent } from '../i18n/utils';
import { siteConfig } from '../data/siteConfig';
import { mainNav } from '../data/navigation';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslation(lang);
const year = new Date().getFullYear();
---

<footer class="bg-[var(--footer-bg)] text-[#F0EAE2]/85 pt-20 pb-12 mt-24">
  <div class="container-page">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-16">
      <div class="md:col-span-5">
        <a href={getLocalizedPath(lang, '/')} class="font-display text-3xl tracking-tight cursor-pointer block mb-4 text-[#F0EAE2]">
          Chloe <span class="italic font-normal text-[#F0EAE2]/60">Trad</span>
        </a>
        <p class="font-display italic text-lg text-[#F0EAE2]/55 leading-relaxed max-w-sm">
          {t('footer.tagline')}
        </p>
      </div>

      <div class="md:col-span-2">
        <h3 class="eyebrow text-[#F0EAE2]/50 mb-4">{t('footer.nav')}</h3>
        <ul class="space-y-2">
          {mainNav.map((item) => (
            <li>
              <a href={getLocalizedPath(lang, item.path)} class="text-sm hover:text-[var(--accent)] transition-colors duration-200 cursor-pointer">
                {t(item.key)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-2">
        <h3 class="eyebrow text-[#F0EAE2]/50 mb-4">{t('footer.elsewhere')}</h3>
        <ul class="space-y-2">
          <li><a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="text-sm hover:text-[var(--accent)] transition-colors duration-200 cursor-pointer">LinkedIn</a></li>
          <li><a href={siteConfig.social.behance} target="_blank" rel="noopener noreferrer" class="text-sm hover:text-[var(--accent)] transition-colors duration-200 cursor-pointer">Behance</a></li>
        </ul>
      </div>

      <div class="md:col-span-3">
        <h3 class="eyebrow text-[#F0EAE2]/50 mb-4">{t('footer.contact')}</h3>
        <ul class="space-y-2 text-sm">
          <li><a href={`mailto:${siteConfig.email}`} class="hover:text-[var(--accent)] transition-colors duration-200 cursor-pointer break-all">{siteConfig.email}</a></li>
          <li class="text-[#F0EAE2]/70">{getLocalizedContent(siteConfig.location, lang)}</li>
        </ul>
      </div>
    </div>

    <div class="border-t border-[#F0EAE2]/10 pt-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
      <p class="text-xs font-mono text-[#F0EAE2]/40 tracking-wide">
        &copy; {year} {siteConfig.name}. {t('footer.rights')}.
      </p>
      <p class="text-xs font-mono text-[#F0EAE2]/40 tracking-wide">{t('footer.colophon')}</p>
    </div>
  </div>
</footer>
