---
import { type Lang } from '../i18n/languages';
import { useTranslation, getLocalizedPath, getLocalizedContent } from '../i18n/utils';
import { siteConfig } from '../data/siteConfig';
import { mainNav } from '../data/navigation';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslation(lang);
const year = new Date().getFullYear();
---

<footer class="bg-[var(--footer-bg)] text-[#F0EAE2]/85 pt-20 pb-12 mt-24">
  <div class="container-page">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-16">
      <div class="md:col-span-5">
        <a href={getLocalizedPath(lang, '/')} class="font-display text-3xl tracking-tight cursor-pointer block mb-4 text-[#F0EAE2]">
          Chloe <span class="italic font-normal text-[#F0EAE2]/60">Trad</span>
        </a>
        <p class="font-display italic text-lg text-[#F0EAE2]/55 leading-relaxed max-w-sm">
          {t('footer.tagline')}
        </p>
      </div>

      <div class="md:col-span-2">
        <h3 class="eyebrow text-[#F0EAE2]/50 mb-4">
          <svg class="inline-block w-3.5 h-3.5 mr-1.5 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" /></svg>
          {t('footer.nav')}
        </h3>
        <ul class="space-y-2">
          {mainNav.map((item) => (
            <li>
              <a href={getLocalizedPath(lang, item.path)} class="text-sm hover:text-[var(--accent)] transition-colors duration-200 cursor-pointer">
                {t(item.key)}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-2">
        <h3 class="eyebrow text-[#F0EAE2]/50 mb-4">
          <svg class="inline-block w-3.5 h-3.5 mr-1.5 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
          {t('footer.elsewhere')}
        </h3>
        <ul class="space-y-2">
          <li>
            <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="text-sm hover:text-[var(--accent)] transition-colors duration-200 cursor-pointer">
              <svg class="inline-block w-3.5 h-3.5 mr-1.5 opacity-60" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3A2 2 0 0121 5V19A2 2 0 0119 21H5A2 2 0 013 19V5A2 2 0 015 3H19M18.5 18.5V13.2A3.26 3.26 0 0015.24 9.94C14.39 9.94 13.4 10.46 12.92 11.24V10.13H10.13V18.5H12.92V13.57C12.92 12.8 13.54 12.17 14.31 12.17A1.4 1.4 0 0115.71 13.57V18.5H18.5M6.88 8.56A1.68 1.68 0 008.56 6.88C8.56 5.95 7.81 5.19 6.88 5.19A1.69 1.69 0 005.19 6.88C5.19 7.81 5.95 8.56 6.88 8.56M8.27 18.5V10.13H5.5V18.5H8.27Z" /></svg>
              LinkedIn
            </a>
          </li>
        </ul>
      </div>

      <div class="md:col-span-3">
        <h3 class="eyebrow text-[#F0EAE2]/50 mb-4">
          <svg class="inline-block w-3.5 h-3.5 mr-1.5 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
          {t('footer.contact')}
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={`mailto:${siteConfig.email}`} class="hover:text-[var(--accent)] transition-colors duration-200 cursor-pointer break-all">
              <svg class="inline-block w-3.5 h-3.5 mr-1.5 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>
              {siteConfig.email}
            </a>
          </li>
          <li class="text-[#F0EAE2]/70">
            <svg class="inline-block w-3.5 h-3.5 mr-1.5 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>
            {getLocalizedContent(siteConfig.location, lang)}
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-[#F0EAE2]/10 pt-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
      <p class="text-xs font-mono text-[#F0EAE2]/40 tracking-wide">
        &copy; {year} {siteConfig.name}. {t('footer.rights')}.
      </p>
      <p class="text-xs font-mono text-[#F0EAE2]/40 tracking-wide">{t('footer.colophon')}</p>
    </div>
  </div>
</footer>
