---
import { type Lang, languages } from '../i18n/languages';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function getSwitchedPath(targetLang: Lang): string {
  const pathWithoutBase = currentPath.replace(new RegExp(`^${base}`), '');
  const newPath = pathWithoutBase.replace(/^\/(en|fr)/, `/${targetLang}`);
  return `${base}${newPath || `/${targetLang}/`}`;
}
---

<nav class="flex items-center gap-1 text-xs font-mono" aria-label="Select language">
  {(Object.keys(languages) as Lang[]).map((l, i) => (
    <>
      {i > 0 && <span class="text-[var(--muted)] mx-1">/</span>}
      <a
        href={getSwitchedPath(l)}
        class:list={[
          'px-1 py-2 transition-colors duration-200 cursor-pointer tracking-[0.1em]',
          l === lang ? 'text-[var(--ink)] font-medium' : 'text-[var(--muted)] hover:text-[var(--ink)]',
        ]}
        aria-current={l === lang ? 'true' : undefined}
      >
        {languages[l].label}
      </a>
    </>
  ))}
</nav>
