---
import { type Lang, languages } from '../i18n/languages';
import { getDirection, useTranslation } from '../i18n/utils';
import { siteConfig } from '../data/siteConfig';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang: Lang;
  accent?: string;
}

const { title, description, image, lang, accent } = Astro.props;
const dir = getDirection(lang);
const t = useTranslation(lang);
const fullTitle = title ? `${title} — ${siteConfig.name}` : siteConfig.name;
const metaDescription = description || (lang === 'fr' ? 'Designer graphique — identité, typographie, motion, UI/UX.' : 'Graphic designer — identity, typography, motion, UI/UX.');
---

<!doctype html>
<html lang={lang} dir={dir} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F5F1EC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14110F" media="(prefers-color-scheme: dark)" />

    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    {image && <meta property="og:image" content={image} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />

    <!-- Hreflang -->
    {Object.keys(languages).map((l) => (
      <link rel="alternate" hreflang={l} href={`${base}${l}/`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${base}en/`} />

    <!-- Fonts preload (most-used cuts) -->
    <link rel="preload" href={`${base}fonts/fraunces-600.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/inter-400.woff2`} as="font" type="font/woff2" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <!-- Per-project accent (chromatic theme) -->
    {accent && <style set:html={`:root { --accent: ${accent}; }`}></style>}

    <!-- Theme initialization (prevent FOUC) -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="grain-overlay min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">{t('common.skip')}</a>
    <Header lang={lang} currentPath={Astro.url.pathname} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
