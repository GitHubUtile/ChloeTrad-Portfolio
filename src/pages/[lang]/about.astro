---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScrollReveal from '../../islands/ScrollReveal.tsx';
import { type Lang, languages } from '../../i18n/languages';
import { useTranslation, getLocalizedPath } from '../../i18n/utils';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = useTranslation(lang);

const tools = [
  'Adobe Illustrator',
  'Adobe Photoshop',
  'Adobe InDesign',
  'Adobe After Effects',
  'Blender',
  'Figma',
  'Adobe XD',
  'Substance Painter',
  'Python',
];
---

<BaseLayout title={t('about.title')} description={t('about.lead')} lang={lang}>
  <section class="pt-36 lg:pt-52 pb-20 lg:pb-32">
    <div class="container-page">
      <p class="eyebrow mb-8">{t('about.eyebrow')}</p>
      <h1 class="font-display font-semibold text-[clamp(2.75rem,8vw,6rem)] leading-[0.95] text-balance max-w-4xl">
        {t('about.heading')}
      </h1>
    </div>
  </section>

  <section class="pb-28 lg:pb-40">
    <div class="container-page grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24">
      <ScrollReveal client:visible className="lg:col-span-5">
        <div class="aspect-[3/4] sticky top-28 overflow-hidden relative bg-[var(--accent-soft)]">
          <!-- Typographic portrait placeholder -->
          <div class="absolute inset-0 flex flex-col">
            <div class="flex-1 flex items-end justify-start p-8 lg:p-10">
              <span class="font-display font-semibold leading-[0.8] text-[clamp(7rem,18vw,14rem)] text-[var(--ink)]">C</span>
            </div>
            <div class="flex-1 flex items-start justify-end p-8 lg:p-10">
              <span class="font-display italic font-normal leading-[0.8] text-[clamp(7rem,18vw,14rem)] text-[var(--accent)]">T</span>
            </div>
          </div>
          <div class="absolute top-6 right-6 font-mono text-[0.65rem] tracking-[0.2em] uppercase text-[var(--ink)]/60">
            Portrait TK
          </div>
          <div class="absolute bottom-6 left-6 font-mono text-[0.65rem] tracking-[0.2em] uppercase text-[var(--ink)]/60">
            {t('hero.name')} · 2026
          </div>
        </div>
      </ScrollReveal>

      <div class="lg:col-span-7">
        <ScrollReveal client:visible>
          <p class="text-[clamp(1.15rem,2vw,1.5rem)] leading-[1.9] text-[var(--ink)] text-pretty">
            {t('about.lead')}
          </p>
        </ScrollReveal>

        <div class="mt-20 lg:mt-28">
          <ScrollReveal client:visible>
            <h2 class="font-display text-2xl lg:text-3xl mb-6">{t('about.philosophy.title')}</h2>
            <p class="text-[var(--ink)] leading-relaxed max-w-prose text-pretty">
              {t('about.philosophy.body')}
            </p>
          </ScrollReveal>
        </div>

        <div class="mt-20 lg:mt-28">
          <ScrollReveal client:visible>
            <h2 class="font-display text-2xl lg:text-3xl mb-6">{t('about.obsessions.title')}</h2>
            <ul class="space-y-4 max-w-prose">
              <li class="flex items-baseline gap-3 text-lg lg:text-xl">
                <span class="font-mono text-xs text-[var(--accent)]">01</span>
                <span>{t('about.obsessions.0')}</span>
              </li>
              <li class="flex items-baseline gap-3 text-lg lg:text-xl">
                <span class="font-mono text-xs text-[var(--accent)]">02</span>
                <span>{t('about.obsessions.1')}</span>
              </li>
              <li class="flex items-baseline gap-3 text-lg lg:text-xl">
                <span class="font-mono text-xs text-[var(--accent)]">03</span>
                <span>{t('about.obsessions.2')}</span>
              </li>
            </ul>
          </ScrollReveal>
        </div>

        <div class="mt-20 lg:mt-28">
          <ScrollReveal client:visible>
            <h2 class="font-display text-2xl lg:text-3xl mb-6">{t('about.toolkit.title')}</h2>
            <ul class="flex flex-wrap gap-2 max-w-prose">
              {tools.map((tool) => (
                <li class="px-3 py-2 text-xs font-mono uppercase tracking-[0.15em] border border-[var(--rule)] rounded-full">
                  {tool}
                </li>
              ))}
            </ul>
          </ScrollReveal>
        </div>

        <div class="mt-16 lg:mt-20">
          <ScrollReveal client:visible>
            <div class="flex flex-wrap items-center gap-4">
              <a href={getLocalizedPath(lang, '/contact')} class="btn-primary">{t('home.contact.cta')}</a>
              <a href="/cv/chloe-trad-cv.pdf" target="_blank" rel="noopener noreferrer" class="btn-ghost">{t('about.cv')} ↗</a>
            </div>
          </ScrollReveal>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
