---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../islands/ContactForm.tsx';
import { type Lang, languages } from '../../i18n/languages';
import { useTranslation, getLocalizedContent } from '../../i18n/utils';
import { siteConfig } from '../../data/siteConfig';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const t = useTranslation(lang);

const projectTypes = [
  t('contact.types.identity'),
  t('contact.types.editorial'),
  t('contact.types.motion'),
  t('contact.types.ui'),
  t('contact.types.other'),
];
---

<BaseLayout title={t('contact.title')} description={t('contact.lead')} lang={lang}>
  <section class="pt-32 lg:pt-44 pb-16 lg:pb-24">
    <div class="container-page">
      <p class="eyebrow mb-6">{t('contact.eyebrow')}</p>
      <h1 class="font-display font-semibold text-[clamp(2.75rem,8vw,6.5rem)] leading-[0.95] text-balance max-w-4xl">
        {t('contact.heading')}
      </h1>
      <p class="mt-6 text-lg text-[var(--muted)] max-w-prose">{t('contact.lead')}</p>
    </div>
  </section>

  <section class="pb-24 lg:pb-32">
    <div class="container-page grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20">
      <aside class="lg:col-span-5">
        <div class="lg:sticky lg:top-28 space-y-8">
          <div>
            <p class="eyebrow mb-2 inline-flex items-center gap-2">
              <span class="inline-block w-2 h-2 rounded-full bg-[var(--accent)] animate-pulse"></span>
              {t('contact.availability')}
            </p>
            <p class="text-sm text-[var(--muted)]">{t('contact.response')}</p>
          </div>

          <dl class="space-y-6">
            <div>
              <dt class="form-label">{t('contact.email')}</dt>
              <dd>
                <a href={`mailto:${siteConfig.email}`} class="font-display text-xl lg:text-2xl hover:text-[var(--accent)] transition-colors duration-200 cursor-pointer break-all">
                  {siteConfig.email}
                </a>
              </dd>
            </div>
            <div>
              <dt class="form-label">{t('contact.location')}</dt>
              <dd class="font-display text-xl lg:text-2xl">{getLocalizedContent(siteConfig.location, lang)}</dd>
            </div>
            <div>
              <dt class="form-label">Elsewhere</dt>
              <dd class="flex gap-4 font-mono text-sm uppercase tracking-[0.15em]">
                <a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--accent)] transition-colors duration-200 cursor-pointer">LinkedIn</a>
              </dd>
            </div>
          </dl>
        </div>
      </aside>

      <div class="lg:col-span-7">
        <ContactForm
          client:visible
          formspreeUrl={siteConfig.formspree.contact}
          labels={{
            name: t('contact.name'),
            email: t('contact.email'),
            projectType: t('contact.projectType'),
            message: t('contact.message'),
            send: t('contact.send'),
            sending: t('contact.sending'),
            success: t('contact.success'),
            error: t('contact.error'),
          }}
          projectTypes={projectTypes}
        />
      </div>
    </div>
  </section>
</BaseLayout>
